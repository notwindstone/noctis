{
  "name": "@noctis/client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The Noctis app: Vue 3 + Capacitor (Android) + Tauri (desktop)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "sync": "bun run build && cap sync",
    "android": "bun run sync && cap open android",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/status-bar": "^8.0.4",
    "@material-symbols/svg-400": "^0.48.1",
    "@noctis/plugin-core": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "fflate": "^0.8.3",
    "music-metadata": "^12.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctis",
  "version": "0.2.0",
  "identifier": "app.noctis.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bunx vite build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Noctis",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#111318",
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A music client you can reshape with plugins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Noctis plays music from your own server and from streaming services, and plugins reshape everything else: screens, buttons, themes, lyrics, new services.",
    "copyright": "Noctis",
    "linux": {
      "deb": {
        "section": "sound",
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 600, "height": 400 },
        "appPosition": { "x": 160, "y": 190 },
        "applicationFolderPosition": { "x": 440, "y": 190 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "noctis"
        ],
        "name": "Noctis plugin",
        "description": "A Noctis plugin archive",
        "mimeType": "application/zip",
        "role": "Viewer"
      }
    ]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Noctis window may do. Plugins run in the same webview, so the HTTP scope is open on purpose: the desktop app is the unrestricted client (no CORS, any header).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "dialog:default",
    "notification:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "http://*:*" }, { "url": "https://*:*" }]
    }
  ]
}

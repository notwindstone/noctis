# Copy to .env (Bun loads it automatically).
NOCTIS_NAME=Noctis
NOCTIS_PORT=4747
NOCTIS_HOST=0.0.0.0
# PostgreSQL (catalog, users, groups, queues, plugin data) and Redis (sessions).
# `docker compose up -d` at the repository root starts both with these settings.
NOCTIS_DATABASE_URL=postgres://noctis:noctis@localhost:5432/noctis
NOCTIS_REDIS_URL=redis://localhost:6379
NOCTIS_SESSION_TTL_DAYS=90
# Plugin cache and (by default) plugins.
NOCTIS_DATA_DIR=./data
# NOCTIS_PLUGINS_DIR=./data/plugins
# The admin created on first start (only when there are no users yet).
# NOCTIS_ADMIN_USER=admin
# NOCTIS_ADMIN_PASSWORD=change-me
# Let anyone create an account (POST /api/noctis/v1/auth/register).
NOCTIS_OPEN_REGISTRATION=false
# Requests without a session act as the "guests" group (browse and stream by default).
NOCTIS_GUEST_ACCESS=false
# Refuse Noctis clients missing a required plugin (like a Minecraft server).
NOCTIS_ENFORCE_CLIENT_PLUGINS=true
NOCTIS_MAX_BODY_BYTES=1048576
# The browser client at "/" (build it with `bun run build:web`), or another build.
NOCTIS_WEB_CLIENT=true
# NOCTIS_WEB_CLIENT_DIR=../client/dist
# For the local-library plugin: its first directories, separated by ":".
# LOCAL_LIBRARY_DIRS=/srv/music

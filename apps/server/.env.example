# Copy to .env (Bun loads it automatically).
NOCTIS_NAME=Noctis
NOCTIS_PORT=4747
NOCTIS_HOST=0.0.0.0
# Database, plugin cache and (by default) plugins.
NOCTIS_DATA_DIR=./data
# .noctis archives or unpacked plugin folders to load.
# NOCTIS_PLUGINS_DIR=./data/plugins
# Refuse API requests from clients missing a required plugin (like a Minecraft server).
NOCTIS_ENFORCE_CLIENT_PLUGINS=true
NOCTIS_MAX_BODY_BYTES=1048576

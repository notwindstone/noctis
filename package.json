{
  "name": "noctis",
  "private": true,
  "type": "module",
  "description": "A music client and server you can reshape with plugins",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/plugins"
  ],
  "scripts": {
    "dev": "bun run --filter @noctis/client dev",
    "dev:server": "bun run --filter @noctis/server dev",
    "build": "bun run --filter @noctis/client build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "sync": "bun run --filter @noctis/client sync",
    "pack-plugin": "bun scripts/pack-plugin.mjs",
    "build:web": "bun run --filter @noctis/client build"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "fflate": "^0.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
